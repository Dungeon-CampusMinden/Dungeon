{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeon.local/schemas/deer.schema.json",
  "title": "DEER Authoring Configuration",
  "description": "Schema for the editable wizard authoring file. Semantic cross-reference checks remain part of the Wizard and generator validators.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "metadata",
    "session",
    "scenario",
    "surfaces",
    "riddleGraph",
    "riddles",
    "assets"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.1-draft"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "riddleGraph": {
      "$ref": "#/$defs/riddleGraph"
    },
    "riddles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/riddle"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "locale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 2
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAudience",
        "priorKnowledge",
        "playerCount",
        "time"
      ],
      "properties": {
        "targetAudience": {
          "type": "string",
          "minLength": 1
        },
        "priorKnowledge": {
          "type": "string",
          "minLength": 1
        },
        "playerCount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limitMinutes",
            "limitMode"
          ],
          "properties": {
            "limitMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "limitMode": {
              "enum": [
                "hard",
                "soft"
              ]
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "themeId",
        "playerRole",
        "premise",
        "mission",
        "introText",
        "successText",
        "failureText"
      ],
      "properties": {
        "themeId": {
          "const": "default"
        },
        "playerRole": {
          "type": "string",
          "minLength": 1
        },
        "premise": {
          "type": "string",
          "minLength": 1
        },
        "mission": {
          "type": "string",
          "minLength": 1
        },
        "introText": {
          "type": "string",
          "minLength": 1
        },
        "successText": {
          "type": "string",
          "minLength": 1
        },
        "failureText": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "world",
            "container",
            "keypad",
            "door"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "riddleGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startNodeId",
        "endNodeId",
        "nodes",
        "edges"
      ],
      "properties": {
        "startNodeId": {
          "$ref": "#/$defs/id"
        },
        "endNodeId": {
          "$ref": "#/$defs/id"
        },
        "nodes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/graphNode"
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "start"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "end"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphEdge"
          }
        }
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "start",
            "riddle",
            "end"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "riddleId": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "riddle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "riddleId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "not": {
                  "const": "riddle"
                }
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "riddleId"
              ]
            }
          }
        }
      ]
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "riddle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "playerFacingTask",
        "assetIds",
        "resources",
        "hints",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "collection",
            "input"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "playerFacingTask": {
          "type": "string",
          "minLength": 1
        },
        "assetIds": {
          "$ref": "#/$defs/idArray"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hint"
          }
        },
        "parameters": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surfaceId",
                  "slotType",
                  "inputMode",
                  "answer",
                  "maxLength",
                  "successEffect"
                ],
                "properties": {
                  "surfaceId": {
                    "$ref": "#/$defs/id"
                  },
                  "slotType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "inputMode": {
                    "const": "numeric"
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxLength": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minLength": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "showDigitCount": {
                    "type": "boolean"
                  },
                  "acceptedCharacters": {
                    "const": "digits"
                  },
                  "successEffect": {
                    "$ref": "#/$defs/successEffect"
                  },
                  "successFeedback": {
                    "type": "string",
                    "minLength": 1
                  },
                  "wrongFeedback": {
                    "type": "string",
                    "minLength": 1
                  },
                  "retryPolicy": {
                    "const": "infinite_retry"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "collection"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "surfaceId",
                  "slotType",
                  "sourceKind",
                  "rewardMode",
                  "resourceIds"
                ],
                "properties": {
                  "surfaceId": {
                    "$ref": "#/$defs/id"
                  },
                  "slotType": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sourceKind": {
                    "enum": [
                      "container",
                      "world_object"
                    ]
                  },
                  "rewardMode": {
                    "const": "find_resource"
                  },
                  "resourceIds": {
                    "$ref": "#/$defs/idArray",
                    "minItems": 1
                  },
                  "consumeOnCollect": {
                    "type": "boolean"
                  },
                  "repeatable": {
                    "type": "boolean"
                  },
                  "successFeedback": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "rewards"
                      ]
                    },
                    {
                      "required": [
                        "successEffect"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "availability",
        "purpose"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "inline_text",
            "asset",
            "world_object",
            "computer_file"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string"
        },
        "availability": {
          "enum": [
            "visible_in_level",
            "inside_container",
            "after_riddle",
            "generated_by_riddle"
          ]
        },
        "requiredRiddleId": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "enum": [
            "clue",
            "context",
            "instruction",
            "decoy"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "after_riddle"
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "required": [
              "requiredRiddleId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "asset"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "assetId"
            ]
          }
        }
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "integer",
          "minimum": 1
        },
        "unlock": {
          "$ref": "#/$defs/hintUnlock"
        }
      }
    },
    "hintUnlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "conditions"
      ],
      "properties": {
        "operator": {
          "enum": [
            "all_of",
            "any_of"
          ]
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hintUnlockCondition"
          }
        }
      }
    },
    "hintUnlockCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "elapsed_time",
            "failed_attempts",
            "riddle_completed"
          ]
        },
        "seconds": {
          "type": "integer",
          "minimum": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "riddleId": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "elapsed_time"
              }
            }
          },
          "then": {
            "required": [
              "seconds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "failed_attempts"
              }
            }
          },
          "then": {
            "required": [
              "riddleId",
              "count"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "riddle_completed"
              }
            }
          },
          "then": {
            "required": [
              "riddleId"
            ]
          }
        }
      ]
    },
    "successEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "set_state",
            "unlock_surface",
            "open_surface"
          ]
        },
        "stateId": {
          "$ref": "#/$defs/id"
        },
        "surfaceId": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "set_state"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "stateId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "unlock_surface",
                  "open_surface"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "surfaceId"
            ]
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "mediaType",
        "purpose",
        "linkedTo",
        "required",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "audio/wav",
            "audio/mp3",
            "audio/ogg",
            "text/plain"
          ]
        },
        "purpose": {
          "enum": [
            "riddle_evidence",
            "lore",
            "feedback",
            "decorative",
            "audio_cue"
          ]
        },
        "linkedTo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "type",
            "license"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
