{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon:wizard:deer-schema:0.2-draft",
  "title": "DEER Authoring Configuration V0.2",
  "description": "Finalized Wizard-to-generator contract. Incomplete UI drafts use a separate private model. Cross-reference, graph-profile, path-content and runtime-capability checks are semantic validations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "metadata",
    "learningDesign",
    "session",
    "scenario",
    "surfaces",
    "riddleGraph",
    "riddles",
    "assets"
  ],
  "properties": {
    "formatVersion": {
      "const": "0.2-draft"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "learningDesign": {
      "$ref": "#/$defs/learningDesign"
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "world"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "door"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "riddleGraph": {
      "$ref": "#/$defs/riddleGraph"
    },
    "riddles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/riddle"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "session": {
            "type": "object",
            "properties": {
              "time": {
                "type": "object",
                "properties": {
                  "limitMode": {
                    "const": "hard"
                  }
                },
                "required": [
                  "limitMode"
                ]
              }
            },
            "required": [
              "time"
            ]
          }
        },
        "required": [
          "session"
        ]
      },
      "then": {
        "properties": {
          "scenario": {
            "required": [
              "failureText"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "locale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "locale": {
          "const": "de-DE"
        },
        "description": {
          "$ref": "#/$defs/nonBlankString"
        },
        "author": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "learningDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectives",
        "debriefPrompts"
      ],
      "properties": {
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/learningObjective"
          }
        },
        "debriefPrompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlankString"
          },
          "uniqueItems": true
        }
      }
    },
    "learningObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetAudience",
        "priorKnowledge",
        "playerCount",
        "time"
      ],
      "properties": {
        "targetAudience": {
          "$ref": "#/$defs/nonBlankString"
        },
        "priorKnowledge": {
          "$ref": "#/$defs/nonBlankString"
        },
        "playerCount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limitMinutes",
            "limitMode"
          ],
          "properties": {
            "limitMinutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240
            },
            "limitMode": {
              "enum": [
                "hard",
                "soft"
              ]
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "themeId",
        "playerRole",
        "premise",
        "mission",
        "introText",
        "successText"
      ],
      "properties": {
        "themeId": {
          "const": "default"
        },
        "playerRole": {
          "$ref": "#/$defs/nonBlankString"
        },
        "premise": {
          "$ref": "#/$defs/nonBlankString"
        },
        "mission": {
          "$ref": "#/$defs/nonBlankString"
        },
        "introText": {
          "$ref": "#/$defs/nonBlankString"
        },
        "successText": {
          "$ref": "#/$defs/nonBlankString"
        },
        "failureText": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "world",
            "container",
            "keypad",
            "door"
          ]
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "riddleGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startNodeId",
        "endNodeId",
        "nodes",
        "edges"
      ],
      "properties": {
        "startNodeId": {
          "$ref": "#/$defs/id"
        },
        "endNodeId": {
          "$ref": "#/$defs/id"
        },
        "nodes": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/graphNode"
          },
          "allOf": [
            {
              "contains": {
                "$ref": "#/$defs/startNode"
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "$ref": "#/$defs/endNode"
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "edges": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/graphEdge"
          }
        }
      }
    },
    "graphNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/startNode"
        },
        {
          "$ref": "#/$defs/riddleNode"
        },
        {
          "$ref": "#/$defs/endNode"
        }
      ]
    },
    "startNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "start"
        }
      }
    },
    "riddleNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "riddleId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "riddle"
        },
        "riddleId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "endNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "surfaceId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "end"
        },
        "surfaceId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "riddle": {
      "oneOf": [
        {
          "$ref": "#/$defs/collectionRiddle"
        },
        {
          "$ref": "#/$defs/inputRiddle"
        }
      ]
    },
    "collectionRiddle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "learningObjectiveIds",
        "playerFacingTask",
        "estimatedMinutes",
        "resources",
        "hints",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "collection"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "learningObjectiveIds": {
          "$ref": "#/$defs/nonEmptyIdArray"
        },
        "playerFacingTask": {
          "$ref": "#/$defs/nonBlankString"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          },
          "contains": {
            "$ref": "#/$defs/inlineTextResource"
          },
          "minContains": 1
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hint"
          }
        },
        "parameters": {
          "$ref": "#/$defs/collectionParameters"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "parameters": {
                "properties": {
                  "sourceKind": {
                    "const": "container"
                  }
                },
                "required": [
                  "sourceKind"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          },
          "then": {
            "properties": {
              "resources": {
                "items": {
                  "properties": {
                    "availability": {
                      "const": "inside_container"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parameters": {
                "properties": {
                  "sourceKind": {
                    "const": "world_object"
                  }
                },
                "required": [
                  "sourceKind"
                ]
              }
            },
            "required": [
              "parameters"
            ]
          },
          "then": {
            "properties": {
              "resources": {
                "items": {
                  "properties": {
                    "availability": {
                      "const": "visible_in_level"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "inputRiddle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "learningObjectiveIds",
        "playerFacingTask",
        "estimatedMinutes",
        "resources",
        "hints",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "input"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "hard"
          ]
        },
        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "learningObjectiveIds": {
          "$ref": "#/$defs/nonEmptyIdArray"
        },
        "playerFacingTask": {
          "$ref": "#/$defs/nonBlankString"
        },
        "resources": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hint"
          }
        },
        "parameters": {
          "$ref": "#/$defs/numericInputParameters"
        }
      }
    },
    "nonEmptyIdArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "collectionParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "sourceKind",
        "rewardMode",
        "resourceIds"
      ],
      "properties": {
        "surfaceId": {
          "$ref": "#/$defs/id"
        },
        "sourceKind": {
          "enum": [
            "container",
            "world_object"
          ]
        },
        "rewardMode": {
          "const": "find_resource"
        },
        "resourceIds": {
          "$ref": "#/$defs/nonEmptyIdArray"
        }
      }
    },
    "numericInputParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "inputMode",
        "answer",
        "showDigitCount"
      ],
      "properties": {
        "surfaceId": {
          "$ref": "#/$defs/id"
        },
        "inputMode": {
          "const": "numeric"
        },
        "answer": {
          "type": "string",
          "pattern": "^[0-9]{1,8}$"
        },
        "showDigitCount": {
          "type": "boolean"
        }
      }
    },
    "resource": {
      "oneOf": [
        {
          "$ref": "#/$defs/inlineTextResource"
        },
        {
          "$ref": "#/$defs/assetResource"
        }
      ]
    },
    "inlineTextResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "text",
        "availability",
        "purpose"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "inline_text"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "text": {
          "$ref": "#/$defs/nonBlankString"
        },
        "availability": {
          "$ref": "#/$defs/resourceAvailability"
        },
        "purpose": {
          "$ref": "#/$defs/resourcePurpose"
        }
      }
    },
    "assetResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "assetId",
        "availability",
        "purpose"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "asset"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "assetId": {
          "$ref": "#/$defs/id"
        },
        "availability": {
          "$ref": "#/$defs/resourceAvailability"
        },
        "purpose": {
          "$ref": "#/$defs/resourcePurpose"
        }
      }
    },
    "resourceAvailability": {
      "enum": [
        "visible_in_level",
        "inside_container"
      ]
    },
    "resourcePurpose": {
      "enum": [
        "clue",
        "context",
        "instruction",
        "decoy"
      ]
    },
    "hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "severity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/nonBlankString"
        },
        "text": {
          "$ref": "#/$defs/nonBlankString"
        },
        "severity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "mediaType",
        "purpose",
        "source",
        "accessibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/custom/[0-9a-f]{12}-[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg"
          ]
        },
        "purpose": {
          "enum": [
            "riddle_evidence",
            "decorative"
          ]
        },
        "source": {
          "$ref": "#/$defs/assetSource"
        },
        "accessibility": {
          "$ref": "#/$defs/assetAccessibility"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "riddle_evidence"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "accessibility": {
                "properties": {
                  "decorative": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "decorative"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "accessibility": {
                "properties": {
                  "decorative": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      ]
    },
    "assetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "license"
      ],
      "properties": {
        "type": {
          "enum": [
            "educator_upload",
            "bundled_asset"
          ]
        },
        "license": {
          "$ref": "#/$defs/nonBlankString"
        },
        "attribution": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "assetAccessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decorative"
      ],
      "properties": {
        "decorative": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/nonBlankString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decorative": {
                "const": false
              }
            },
            "required": [
              "decorative"
            ]
          },
          "then": {
            "required": [
              "description"
            ]
          }
        }
      ]
    }
  }
}
