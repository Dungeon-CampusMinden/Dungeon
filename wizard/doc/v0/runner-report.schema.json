{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dungeon:wizard:runner-report:0.3",
  "title": "Wizard Runner Report V0.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command",
    "valid",
    "runnerVersion",
    "rawDeerSha256",
    "hostInputSha256",
    "issues"
  ],
  "properties": {
    "command": {
      "enum": [
        "validate",
        "host",
        "join"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "runnerVersion": {
      "$ref": "#/$defs/optionalText"
    },
    "rawDeerSha256": {
      "$ref": "#/$defs/optionalSha256"
    },
    "hostInputSha256": {
      "$ref": "#/$defs/optionalSha256"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "optionalText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "optionalSha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "phase",
        "code",
        "messageKey",
        "arguments",
        "path",
        "entity",
        "relatedPaths"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "phase": {
          "enum": [
            "input",
            "schema",
            "references",
            "graph",
            "capability",
            "assets",
            "feasibility"
          ]
        },
        "code": {
          "enum": [
            "ASSET_CONTENT_MISMATCH",
            "ASSET_DECLARED_UNUSED",
            "ASSET_FILE_UNREFERENCED",
            "ASSET_HASH_MISMATCH",
            "ASSET_MISSING",
            "ASSET_PATH_DUPLICATE",
            "ASSET_PATH_UNSAFE",
            "CLIENT_BOOTSTRAP_FAILED",
            "FORMAT_VERSION_UNSUPPORTED",
            "GRAPH_CYCLE",
            "GRAPH_EDGE_INVALID",
            "GRAPH_NODE_NO_PATH_TO_END",
            "GRAPH_NODE_UNREACHABLE",
            "GRAPH_PROFILE_INVALID",
            "GRAPH_RIDDLE_UNREACHABLE",
            "ID_DUPLICATE",
            "INPUT_CHANGED_DURING_RUN",
            "INPUT_DEER_TOO_LARGE",
            "INPUT_DEER_UNREADABLE",
            "INPUT_PROJECT_INVALID",
            "INPUT_UTF8_BOM",
            "INPUT_UTF8_INVALID",
            "INTERNAL_ERROR",
            "JSON_DUPLICATE_KEY",
            "JSON_PARSE_INVALID",
            "JSON_UNICODE_INVALID",
            "PLAYER_COUNT_INVALID",
            "REFERENCE_UNKNOWN",
            "RUNNER_CAPACITY_EXCEEDED",
            "RUNNER_START_FAILED",
            "SCHEMA_INVALID",
            "SURFACE_CARDINALITY_INVALID",
            "SURFACE_INCOMPATIBLE",
            "SURFACE_OWNERSHIP_INVALID",
            "TEXT_LONG"
          ]
        },
        "messageKey": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scalar"
          }
        },
        "path": {
          "type": "string"
        },
        "entity": {
          "oneOf": [
            {
              "$ref": "#/$defs/entity"
            },
            {
              "type": "null"
            }
          ]
        },
        "relatedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    }
  }
}
