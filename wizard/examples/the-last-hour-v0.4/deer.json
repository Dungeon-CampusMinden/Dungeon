  "learningDesign": {
    "objectives": [
      {
        "id": "lo_recognize_phishing",
        "description": "Die Lernenden können eine legitime Support-Nachricht und Webadresse von Phishing-Nachrichten unterscheiden."
      },
      {
        "id": "lo_decode_representations",
        "description": "Die Lernenden können Informationen zwischen Binär-, Hexadezimal-, ASCII- und Morse-Darstellungen übertragen."
      },
      {
        "id": "lo_follow_incident_clues",
        "description": "Die Lernenden können verteilte digitale und physische Hinweise zu einer nachvollziehbaren Lösungskette verbinden."
      },
      {
        "id": "lo_coordinate_team",
        "description": "Die Lernenden können Fundstücke und Zwischenergebnisse im Team zusammenführen."
      }
    ],
    "debriefPrompts": [
      "Woran habt ihr die echte Support-Nachricht und die echte URL erkannt?",
      "Welche Darstellungsschritte waren nötig, um aus dem Recovery-Code eine lesbare Zahl zu erhalten?",
      "Welche Hinweise waren nur Ablenkung, und wie habt ihr das erkannt?",
      "Wie habt ihr eure Funde und Zwischenergebnisse im Team organisiert?"
    ]
  },
  "session": {
    "targetAudience": "Lernende im Bereich IT-Sicherheit",
    "priorKnowledge": "Grundlagen zu Phishing, Binär- und Hexadezimalzahlen sowie einfachen Codierungen sind hilfreich, aber nicht zwingend erforderlich.",
    "playerCount": {
      "min": 1,
      "max": 2
