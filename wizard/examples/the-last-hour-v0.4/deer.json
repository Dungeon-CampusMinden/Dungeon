  },
  "scenario": {
    "themeId": "default",
    "mission": "Rekonstruiert Mertens' letzte Schritte, stellt den Zugriff auf seine Systeme wieder her und öffnet den Ausgang, bevor die Zeit abläuft.",
    "introText": [
      "Die Tür fällt hinter euch ins Schloss. Auf dem Schreibtisch liegen zurückgelassene Notizen, und Mertens' Systeme warten auf die richtigen Wiederherstellungscodes."
    ],
    "successText": [
      "Der letzte Code ist korrekt. Der Ausgang öffnet sich und das gesamte Team verlässt rechtzeitig den Raum."
    ],
    "failureText": [
      "Die letzte Stunde ist verstrichen, bevor der Ausgang geöffnet werden konnte."
    ]
  },
