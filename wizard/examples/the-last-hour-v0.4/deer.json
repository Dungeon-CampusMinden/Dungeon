  "riddles": [
    {
      "id": "r_recover_access",
      "title": "Mertens' Zugang rekonstruieren",
      "difficulty": "medium",
      "estimatedMinutes": 8,
      "learningObjectiveIds": [
        "lo_recognize_phishing",
        "lo_follow_incident_clues",
        "lo_coordinate_team"
      ],
      "informationSources": [
        {
          "id": "source_incident_notes",
          "surfaceId": "s_desk",
          "resources": [
            {
              "id": "res_login_fragments",
              "kind": "inline_text",
              "title": "Zwei Teile der Zugangsdaten",
              "text": "Die beiden Notizen enthalten die Fragmente A12B und B34xy. Zusammengesetzt ergeben sie Mertens' Zugangshinweis."
            },
            {
              "id": "res_support_message",
              "kind": "inline_text",
              "title": "Legitime SecuGate-Nachricht",
              "text": "Andreas Keller <andreas.keller@secugate.com>: Re: SG-4 Access Code - Controlled Reconstruction. Ziel: https://support.secugate.com/sg4/recovery-sequence"
            },
            {
              "id": "res_recovery_sequence",
              "kind": "inline_text",
              "title": "SG-4-Recovery-Sequenz",
              "text": "00110110 00110101 00110100 00111000"
            },
            {
              "id": "res_conversion_path",
              "kind": "inline_text",
              "title": "Umwandlungsweg",
              "text": "Teilt die Binärfolge in Vierergruppen, überführt sie in Hexadezimalzeichen und interpretiert anschließend jeweils zwei Hexadezimalzeichen als ASCII."
            }
          ]
        }
      ],
      "inputs": [
        {
          "id": "input_collect_incident_notes",
          "type": "collection",
          "informationSourceId": "source_incident_notes"
        },
        {
          "id": "input_recovery_sequence",
          "type": "numeric",
          "surfaceId": "s_recovery_keypad",
          "answer": "6548",
          "showDigitCount": true
        }
      ],
      "hints": [
        {
          "id": "h_incident_notes_1",
          "title": "Domain vergleichen",
          "text": "Die legitime Nachricht stammt von Andreas Keller und führt direkt zu secugate.com.",
          "severity": "orientation"
        },
        {
          "id": "h_incident_notes_2",
          "title": "Binärfolge",
          "text": "Bearbeitet die vier Bytes von links nach rechts.",
          "severity": "orientation"
        },
        {
          "id": "h_recovery_1",
          "title": "Vierergruppen",
          "text": "Teilt jedes Byte in zwei Vierergruppen und übersetzt diese zunächst nach Hexadezimal.",
          "severity": "approach"
        },
        {
          "id": "h_recovery_2",
          "title": "ASCII",
          "text": "Je zwei Hexadezimalzeichen ergeben ein ASCII-Zeichen.",
          "severity": "approach"
        }
      ]
    },
