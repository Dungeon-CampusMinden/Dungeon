      "questions": [
        {
          "id": "b09_bubble_sort_schritt",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Welche Beschreibung passt zu einem einzelnen Schritt von Bubble Sort?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Der größte Wert wird gesucht und sofort ans Ende gesetzt."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Das Array wird halbiert, und beide Hälften werden getrennt sortiert."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Jeder Wert wird mit dem Durchschnitt aller Werte verglichen."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Zwei direkt nebeneinanderliegende Werte werden verglichen und getauscht, falls sie falsch herum stehen."
              }
            }
          ]
        },
        {
          "id": "b10_bubble_sort_bedingung",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "In einem Bubble Sort steht `if (zahlen[j] < zahlen[j + 1]) { /* tauschen */ }`. Was bewirkt diese Bedingung?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Es wird getauscht, wenn der linke Wert kleiner ist; das Array wird aufsteigend sortiert."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Es wird geprüft, ob das gesamte Array bereits sortiert ist."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Es wird getauscht, wenn der linke Wert kleiner ist; das Array wird absteigend sortiert."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Es wird getauscht, wenn beide Werte gleich groß sind."
              }
            }
          ]
        },
        {
          "id": "b11_bubble_sort_durchlauf",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Bubble Sort sortiert `{40, 10, 50, 20, 30}` aufsteigend. Wie sieht das Array nach dem ersten Durchlauf aus? Im ersten Durchlauf wird jedes benachbarte Paar einmal von links nach rechts verglichen."
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "`{10, 40, 20, 30, 50}`"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "`{10, 20, 30, 40, 50}`"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`{10, 40, 50, 20, 30}`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "`{10, 40, 20, 50, 30}`"
              }
            }
          ]
        },
        {
          "id": "b12_tausch_ohne_hilfsvariable",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Ein Tausch in einem Sortierprogramm lautet:\n`werte[j + 1] = werte[j]; werte[j] = werte[j + 1];`\nVorher gilt `werte[j] = 9` und `werte[j + 1] = 4`. Welche Aussage trifft zu?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Der Tausch funktioniert: Danach steht 4 vor 9."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Beide Stellen enthalten danach 4, weil der linke Wert zuerst überschrieben wird."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Das Programm bricht ab, weil `j + 1` kein gültiger Index-Ausdruck ist."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Beide Stellen enthalten danach 9, weil die 4 überschrieben wird, bevor sie gesichert ist."
              }
            }
          ]
        }
      ]
    },
