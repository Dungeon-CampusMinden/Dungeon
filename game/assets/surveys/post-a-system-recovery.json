    {
      "title": {
        "de": "Arrays durchlaufen"
      },
      "questions": [
        {
          "id": "b05_for_each_schleife",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Welche Schleifenform liefert dir in jedem Durchlauf direkt das nächste Element von `pakete`, ohne dass du einen Index verwendest?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "`while (pakete.length > 0) { ... }`"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "`if (pakete.length > 0) { ... }`"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`for (int i = 0; i < pakete.length; i++) { ... }`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "`for (int p : pakete) { ... }`"
              }
            }
          ]
        },
