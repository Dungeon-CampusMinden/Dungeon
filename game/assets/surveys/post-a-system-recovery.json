            },
            {
              "id": "b",
              "text": {
                "de": "Das letzte Element wird zweimal ausgegeben."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Das erste Element wird übersprungen."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Die Schleife läuft endlos."
              }
            }
          ]
        },
