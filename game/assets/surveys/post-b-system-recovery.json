              "text": {
                "de": "`int[] lager = new int[3][4];`"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`int[][] lager = new int[3, 4];`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "`int[][] lager = new int[12];`"
              }
            }
          ]
        },
        {
          "id": "a14_zeilen_und_spalten",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Es gilt `int[][] lager = new int[3][4];`. Was liefern `lager.length` und `lager[0].length`?"
          },
