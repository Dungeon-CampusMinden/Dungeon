    {
      "title": {
        "de": "Methoden"
      },
      "questions": [
        {
          "id": "b09_methoden_definition",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Welche Aussage beschreibt eine Methode am besten?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Sie legt fest, welche Farbe ein Programm hat."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Sie bündelt zusammengehörige Arbeitsschritte unter einem Namen, sodass man sie bei Bedarf aufrufen kann."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Sie sorgt dafür, dass alle Variablen denselben Wert haben."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Sie startet das gesamte Programm nach jedem Schritt neu."
              }
            }
          ]
        },
        {
          "id": "b10_methoden_ausgabe_parameter",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Eine Methode soll immer den Text \"Bereit!\" anzeigen. Eine zweite soll beim Aufruf einen Text erhalten und diesen anzeigen. Welche Aussage passt?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Für die zweite Methode kann der Text als Parameter übergeben werden; für die erste ist keiner nötig."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Beide Methoden müssen immer genau zwei Parameter erhalten."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Ein Parameter speichert einen Text dauerhaft für alle späteren Aufrufe."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Die erste Methode muss ihre Nachricht als Ergebnis bereitstellen."
              }
            }
          ]
        },
        {
          "id": "b11_rueckgabewert_differenz",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Eine Methode namens \"differenz\" erhält zwei Zahlen und liefert die erste Zahl minus die zweite als Ergebnis. Was liefert sie für 17 und 9?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "26"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "8"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "9"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "17"
              }
            }
          ]
        },
        {
          "id": "b12_methodenergebnis_verknuepfen",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Ein Programm nutzt zwei Methoden: Eine berechnet einen Endpreis, der danach für eine weitere Rechnung gebraucht wird. Die andere zeigt nur den Text \"Willkommen!\" an. Welche Aussage passt?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Beide Methoden müssen immer einen Zahlenwert als Ergebnis bereitstellen."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Nur die Methode, die eine Nachricht anzeigt, muss ihr Ergebnis für eine weitere Rechnung bereitstellen."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Keine Methode kann ohne Eingabewerte ausgeführt werden."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Die Methode für den Endpreis sollte das Ergebnis bereitstellen; die Begrüßungsmethode kann die Nachricht anzeigen, ohne ein Ergebnis zu liefern."
              }
            }
          ]
        }
      ]
    },
    {
      "title": {
        "de": "Bedingungen: if / else"
