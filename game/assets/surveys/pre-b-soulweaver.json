          "options": [
            {
              "id": "a",
              "text": {
                "de": "`for`"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "`while`"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`if`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "`else`"
              }
            }
          ]
        },
        {
          "id": "b14_verschachtelte_bedingung",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Was passiert bei diesem Code, wenn `temperatur` den Wert `18` hat?\n`if (temperatur >= 20) { if (regen > 0) { System.out.println(\"X\"); } } else { System.out.println(\"Y\"); }`"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Die innere Bedingung wird immer zuerst geprüft."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Der äußere `else`-Zweig wird ausgeführt; die innere Bedingung wird nicht geprüft."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Beide Ausgaben werden ausgeführt."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Die `if`-Anweisung wiederholt sich, bis die Bedingung wahr ist."
              }
            }
          ]
        },
        {
          "id": "b15_if_else_ausgabe",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Welche Ausgabe entsteht?\n`int punkte = 38; if (punkte >= 40) { System.out.println(\"Grenze erreicht\"); } else { System.out.println(\"Unter der Grenze\"); }`"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "`Grenze erreicht`"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Beide Texte"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`Unter der Grenze`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Keine Ausgabe"
              }
            }
          ]
        },
        {
          "id": "b16_verschachtelte_ausgabe",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Welche Ausgabe entsteht?\n`int punkte = 65; if (punkte >= 50) { if (punkte <= 60) { System.out.println(\"X\"); } else { System.out.println(\"Y\"); } } else { System.out.println(\"Z\"); }`"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "`Y`"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "`X`"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`Z`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Keine Ausgabe"
              }
            }
          ]
        }
