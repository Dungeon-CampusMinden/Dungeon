        {
          "id": "b06_while_bedingung",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Der Wert von `x` ist am Anfang 10. Die Schleife lautet `while (x < 5) { x++; }`. Welche Aussage ist richtig?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Der Inhalt der Schleife wird kein einziges Mal ausgeführt."
