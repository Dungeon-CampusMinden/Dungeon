            {
              "id": "b",
              "text": {
                "de": "Beide Texte"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "`Bestanden`"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Keine Ausgabe"
