        {
          "id": "a14_verschachtelte_bedingung",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Was passiert bei diesem Code, wenn `a` den Wert `-1` hat?\n`if (a > 0) { if (b > 0) { System.out.println(\"X\"); } } else { System.out.println(\"Y\"); }`"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Die innere Bedingung wird immer zuerst geprüft."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Der äußere `else`-Zweig wird ausgeführt; die innere Bedingung wird nicht geprüft."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Beide Ausgaben werden ausgeführt."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Das Programm wiederholt die `if`-Anweisung automatisch."
              }
            }
          ]
        },
