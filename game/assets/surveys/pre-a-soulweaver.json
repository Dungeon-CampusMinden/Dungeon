              }
            },
            {
              "id": "d",
              "text": {
                "de": "`if`"
              }
            }
          ]
        },
        {
          "id": "a06_while_bedingung",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Der Wert von `x` ist am Anfang 4. Die Schleife lautet `while (x < 0) { x++; }`. Welche Aussage ist richtig?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Der Inhalt der Schleife wird kein einziges Mal ausgeführt."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Der Inhalt der Schleife wird genau einmal ausgeführt."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Der Inhalt der Schleife wird viermal ausgeführt."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Die Schleife wird immer mindestens einmal ausgeführt."
              }
