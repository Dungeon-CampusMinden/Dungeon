    {
      "title": {
        "de": "Methoden"
      },
      "questions": [
        {
          "id": "a09_methoden_definition",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Welche Aussage beschreibt eine Methode am besten?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Sie ist ein einzelner gespeicherter Wert, der sich nicht ändern darf."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Sie fasst Arbeitsschritte unter einem Namen zusammen, damit sie bei Bedarf ausgeführt werden können."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Sie entscheidet automatisch, ob eine Bedingung wahr ist."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Sie sorgt dafür, dass eine Schleife immer genau einmal läuft."
              }
            }
          ]
        },
        {
          "id": "a10_methoden_ausgabe_parameter",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Eine Methode soll eine feste Begrüßung anzeigen. Eine zweite soll beim Aufruf den Namen einer anderen Person erhalten und diese begrüßen. Welche Aussage passt?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Beide Methoden müssen immer einen Parameter erhalten."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Die zweite Methode kommt ohne Eingabewert aus, weil der Name automatisch bekannt ist."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Die erste Methode kann ohne Parameter arbeiten; die zweite kann den Namen als Parameter erhalten."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Ein Parameter legt fest, wie oft die Methode ausgeführt wird."
              }
            }
          ]
        },
        {
          "id": "a11_rueckgabewert_summe",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Eine Methode namens \"summe\" erhält zwei Zahlen und liefert ihre Summe als Ergebnis. Welches Ergebnis liefert sie für 12 und 8?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "96"
              }
            },
            {
              "id": "b",
              "text": {
                "de": "4"
              }
            },
            {
              "id": "c",
              "text": {
                "de": "20"
              }
            },
            {
              "id": "d",
              "text": {
                "de": "12"
              }
            }
          ]
        },
        {
          "id": "a12_methodenergebnis_verknuepfen",
          "type": "singleChoice",
          "required": true,
          "text": {
            "de": "Ein Programm nutzt zwei Methoden: Eine berechnet eine Zahl, die danach für eine weitere Rechnung gebraucht wird. Die andere zeigt nur den Text \"Fertig!\" an. Welche Aussage passt?"
          },
          "options": [
            {
              "id": "a",
              "text": {
                "de": "Beide Methoden müssen immer einen Zahlenwert als Ergebnis bereitstellen."
              }
            },
            {
              "id": "b",
              "text": {
                "de": "Die erste Methode sollte ihr Ergebnis bereitstellen; die zweite kann einfach den Text anzeigen."
              }
            },
            {
              "id": "c",
              "text": {
                "de": "Die erste Methode braucht keine Berechnung, und die zweite muss Zahlen entgegennehmen."
              }
            },
            {
              "id": "d",
              "text": {
                "de": "Keine der Methoden kann ohne eine Schleife genutzt werden."
              }
            }
          ]
        }
      ]
